<?xml version="1.0" encoding="UTF-8"?>
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    <!-- Indian urban 4-way arterial: 2 lanes per direction, 3.5m lane width, 50 km/h (13.89 m/s) -->
    <!-- Incoming approaches to center -->
    <edge id="N_to_C" from="north" to="center" numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="S_to_C" from="south" to="center" numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="E_to_C" from="east"  to="center" numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="W_to_C" from="west"  to="center" numLanes="2" speed="13.89" width="3.5" priority="2"/>

    <!-- Outgoing exits from center -->
    <edge id="C_to_N" from="center" to="north" numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="C_to_S" from="center" to="south" numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="C_to_E" from="center" to="east"  numLanes="2" speed="13.89" width="3.5" priority="2"/>
    <edge id="C_to_W" from="center" to="west"  numLanes="2" speed="13.89" width="3.5" priority="2"/>
</edges>
